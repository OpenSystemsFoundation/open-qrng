    <!-- Quantum_Provider__c is Private OWD (H-S3). Regular users must still
         READ provider rows: QuantumProviderFactory.getActiveProvider() and
         the backend cache queries (Provider__r traversal) run 'with sharing',
         so without viewAllRecords the admin-owned provider row would be
         invisible and job submission/backend lists would silently degrade.
         viewAllRecords grants read-only visibility; no create/edit/delete. -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
