<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Quantum_Select_Deals</name>
        <label>Quantum Select Deals for Review</label>
        <locationX>176</locationX>
        <locationY>458</locationY>
        <actionName>OpenSF__QuantumRandomAssignment</actionName>
        <actionType>apex</actionType>
        <inputParameters>
            <name>recordIds</name>
            <value>
                <elementReference>varDealIds</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>assignmentType</name>
            <value>
                <stringValue>Subset</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>sampleSize</name>
            <value>
                <elementReference>varSampleSize</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>purpose</name>
            <value>
                <stringValue>Weekly Pipeline Review Selection</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>useBellTest</name>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputParameters>
        <outputParameters>
            <assignToReference>varJobId</assignToReference>
            <name>jobId</name>
        </outputParameters>
    </actionCalls>
    <apiVersion>66.0</apiVersion>
    <assignments>
        <name>Add_Opp_Id</name>
        <label>Add Opportunity Id</label>
        <locationX>308</locationX>
        <locationY>242</locationY>
        <assignmentItems>
            <assignToReference>varDealIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Opportunities.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Opportunities</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Has_Deals</name>
        <label>Has Eligible Deals?</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <defaultConnectorLabel>No Deals</defaultConnectorLabel>
        <rules>
            <name>Has_Deals</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varDealIds</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Quantum_Select_Deals</targetReference>
            </connector>
            <label>Has Deals</label>
        </rules>
    </decisions>
    <description
    >Select a random subset of open Opportunities for pipeline review using quantum-certified randomization. Runs on a weekly schedule, queries eligible deals above a configurable amount threshold, and uses QuantumFair Subset assignment to select a fair, unbiased sample. A Fairness Certificate proves no cherry-picking occurred.</description>
    <interviewLabel
    >QRNG Opportunity Review {!$Flow.CurrentDateTime}</interviewLabel>
    <isTemplate>true</isTemplate>
    <label>QRNG Opportunity Review Selection</label>
    <loops>
        <name>Loop_Opportunities</name>
        <label>Loop Opportunities</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <collectionReference>Get_Open_Opportunities</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Opp_Id</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Check_Has_Deals</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Open_Opportunities</name>
        <label>Get Open Opportunities</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <connector>
            <targetReference>Loop_Opportunities</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Amount</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>varAmountThreshold</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Open_Opportunities</targetReference>
        </connector>
        <schedule>
            <frequency>Weekly</frequency>
            <startDate>2026-01-05</startDate>
            <startTime>08:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Draft</status>
    <!-- TODO: Adjust varSampleSize and varAmountThreshold for your org -->
    <variables>
        <name>varDealIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varJobId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varSampleSize</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>10.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>varAmountThreshold</name>
        <dataType>Currency</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <numberValue>50000.0</numberValue>
        </value>
    </variables>
</Flow>
